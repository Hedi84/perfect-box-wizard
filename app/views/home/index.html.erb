<h1>Build Your Perfect Box</h1>

<p>Create your food profile and discover recipes picked for you.</p>

<%= button_to "Start onboarding", onboarding_path, method: :get %>

<hr>

<h2>Already started?</h2>

<%= form_with url: session_path do |form| %>
  <%= form.email_field :email, placeholder: "Email" %>
  <%= form.password_field :password, placeholder: "Password" %>
  <%= form.submit "Sign in" %>
<% end %>
