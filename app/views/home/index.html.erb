<div class="hero">
  <%= image_tag "banner_perfect_box.png", alt: "Perfect Box", class: "hero-banner" %>

  <%= link_to "Get started", "#signup", class: "hero-cta",
              data: { controller: "smooth-scroll", action: "click->smooth-scroll#scroll" } %>
</div>

<div class="card" id="signup">
  <h2>Sign in or create an account</h2>

  <p>Sign in to pick up where you left off, or enter an email and password to create an account and start onboarding.</p>

  <%= form_with url: session_path do |form| %>
    <div>
      <%= form.label :email %><br>
      <%= form.email_field :email %>
    </div>

    <div>
      <%= form.label :password %><br>
      <%= form.password_field :password %>
    </div>

    <%= form.submit "Continue" %>
  <% end %>
</div>
