<h1>🥗 What do you love to eat?</h1>

<p>Select all that apply.</p>

<%= form_with model: @onboarding,
              url: step_onboarding_path("preferences"),
              method: :patch do |form| %>

  <% Onboarding::DIETARY_TAGS.each do |tag| %>
    <div>
      <%= check_box_tag "onboarding[dietary_preferences][]",
                        tag,
                        @onboarding.dietary_preferences&.include?(tag),
                        id: tag %>

      <%= label_tag tag, tag.humanize %>
    </div>
  <% end %>

  <%= link_to "← Back", step_onboarding_path("address") %>
  <%= form.submit "Finish" %>

<% end %>