<div class="card">
  <h1>📍 Where should we deliver?</h1>

  <p>Tell us where your weekly boxes should arrive.</p>

  <%= render "errors" %>

  <%= form_with model: @onboarding,
                url: step_onboarding_path("address"),
                method: :patch do |form| %>

    <div>
      <%= form.label :address_line_1 %><br>
      <%= form.text_field :address_line_1 %>
    </div>

    <div>
      <%= form.label :address_line_2 %><br>
      <%= form.text_field :address_line_2 %>
    </div>

    <div>
      <%= form.label :city %><br>
      <%= form.text_field :city %>
    </div>

    <div>
      <%= form.label :postcode %><br>
      <%= form.text_field :postcode %>
    </div>

    <div class="card-actions">
      <%= link_to "← Back", step_onboarding_path("personal") %>
      <%= form.submit "Continue →" %>
    </div>

  <% end %>
</div>
