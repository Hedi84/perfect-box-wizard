<div class="card">
  <h1>🎉 Welcome, <%= @onboarding.first_name %>!</h1>

  <p>Your account has been created successfully.</p>

  <h2>Your details</h2>

  <ul>
    <li><strong>Name:</strong> <%= @onboarding.first_name %> <%= @onboarding.last_name %></li>
    <li><strong>Email:</strong> <%= @onboarding.user.email %></li>
    <li><strong>Address:</strong></li>
    <li>
      <%= @onboarding.address_line_1 %><br>
      <% if @onboarding.address_line_2.present? %>
        <%= @onboarding.address_line_2 %><br>
      <% end %>
      <%= @onboarding.city %><br>
      <%= @onboarding.postcode %>
    </li>
    <li>
      <strong>Dietary preferences:</strong>
      <%= @onboarding.dietary_preferences.map(&:humanize).join(", ") %>
    </li>
  </ul>
</div>

<h2>🍽️ Recipes picked for you</h2>

<%= render "recipes/recipe_cards", recipes: @recipes %>
